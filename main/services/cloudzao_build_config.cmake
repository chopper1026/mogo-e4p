# 正式发布与本机开发的接入配置彼此隔离，不将 ID 写入缓存或命令行。
# Isolate release and local credentials; never put the ID in the cache or command line.
function(mogo_cloudzao_integration_id output)
    set(id "")
    set(source "")
    if(MOGO_PUBLIC_RELEASE)
        if(NOT CONFIG_MOGO_CLOUDZAO_TRANSFER)
            message(FATAL_ERROR "Public releases require CloudZao file reception")
        endif()
        set(id "$ENV{MOGO_CLOUDZAO_INTEGRATION_ID}")
        set(source "the MOGO_CLOUDZAO_INTEGRATION_ID release secret")
    elseif(NOT "$ENV{CI}" AND NOT "$ENV{HOME}" STREQUAL "")
        set(local_file "$ENV{HOME}/.config/mogo-e4p/cloudzao-integration-id")
        # 跟踪配置文件的新增、删除与编辑，避免增量构建沿用旧 ID。
        # Reconfigure on creation, deletion or edits rather than retaining a stale ID.
        file(GLOB local_config LIST_DIRECTORIES false CONFIGURE_DEPENDS "${local_file}")
        if(local_config)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${local_file}")
            if(NOT CONFIG_MOGO_CLOUDZAO_TRANSFER)
                message(FATAL_ERROR "Local CloudZao is configured; enable CONFIG_MOGO_CLOUDZAO_TRANSFER in this build's sdkconfig")
            endif()
            file(READ "${local_file}" id)
            string(STRIP "${id}" id)
            set(source "the local CloudZao configuration at ${local_file}")
        endif()
    endif()
    if(NOT source STREQUAL "")
        string(LENGTH "${id}" length)
        if(length GREATER 256 OR NOT id MATCHES "^[A-Za-z0-9._~+/=-]+$")
            message(FATAL_ERROR "Missing or invalid integration ID in ${source}")
        endif()
    endif()
    set(${output} "${id}" PARENT_SCOPE)
endfunction()
