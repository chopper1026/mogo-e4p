# 目标：ESP32-S31（RISC-V，Metalio E-INK4 Plus）。
# Target: ESP32-S31 (RISC-V, Metalio E-INK4 Plus).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# S31 + Octal PSRAM 200 MHz（Metalio 已验证组合）。flash 保持 80 MHz 默认。
# S31 + octal PSRAM at 200 MHz (validated on Metalio); flash stays at the 80 MHz default.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# 多层 EPUB/PNG 调用留安全余量；大型缓存不得放栈上。/ Reserve nested EPUB/PNG stack headroom; keep large caches off-stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# 首版与 Metalio 一致：UART0 主控制台 + USB Serial/JTAG 次控制台，便于看启动日志。
# Match Metalio for bring-up: UART0 primary console with USB Serial/JTAG secondary.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 无线参数整体对齐厂商 S31 构建（Metalio-E-INK4-Plus 的 sdkconfig 与
# docs/ap-file-transfer.md §12）：静态 RX/TX 6、缓存 TX 4、TX BA 窗口 64、
# 管理缓冲 32，WiFi 热路径代码进 IRAM。
# Radio settings follow the vendor S31 build (Metalio-E-INK4-Plus sdkconfig and
# docs/ap-file-transfer.md §12): static RX/TX 6, cache TX 4, TX BA window 64,
# management buffers 32, and WiFi hot-path code placed in IRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_TX_BA_WIN=64
# TCP 窗口实测过 32 KB 与 64 KB：负载 RTT ~30 ms 时 32 KB 把上行节流在
# ~865 KB/s 且稳定；64 KB 会让发送端冲爆 WiFi/lwIP 接收缓冲（DYNAMIC_RX 32 个
# ≈ 48 KB），丢包塌缩到 ~380 KB/s（2026-10-24 实测）。32 KB 是本板甜点值，
# 缓冲在 PSRAM。厂商的 5760 字节按热点直连 RTT 调优，经路由器的链路不适用。
# Both 32 KB and 64 KB windows were measured: with a ~30 ms under-load RTT the
# 32 KB window paces uploads at a stable ~865 KB/s, while 64 KB lets the sender
# overflow the WiFi/lwIP RX buffers (DYNAMIC_RX 32 ≈ 48 KB) and collapse to
# ~380 KB/s from loss-driven congestion-window drops (measured 2026-10-24).
# 32 KB is this board's sweet spot; buffers live in PSRAM. The vendor's 5760
# bytes is tuned for direct-hotspot RTT and does not apply over a router.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
# WiFi 重传与乱序下保住上行吞吐：接收消息队列与乱序重组预算加深，SACK、
# SO_RCVBUF 打开，与厂商 S31 参考值一致；12 段重组预算仍远小于 32 KB 窗口。
# Preserve upload throughput under retransmission and reordering: deepen the
# TCP receive mailbox and the out-of-order budget, enable SACK and SO_RCVBUF,
# matching the vendor S31 reference; the 12-pbuf budget stays inside the
# 32 KB receive window.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=12
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙翻页器：BLE HID 主机（central），配对市面上的 BLE 翻页器／键盘。
# Bluetooth page-turner: a BLE HID host (central) pairing off-the-shelf BLE remotes.
#
# 目前 host 用 NimBLE，只做 BLE。S31 本身有 Bluetooth Classic 硬件，但 NimBLE 不支持
# BR/EDR；要接纯 Classic 翻页器得换 Bluedroid（另一轮评估）。
# The host is NimBLE, so this build is BLE only. The S31 itself has Bluetooth Classic hardware,
# but NimBLE has no BR/EDR; Classic-only remotes would need Bluedroid (separate work).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# host 的全部动态分配走 PSRAM，内部 RAM 留给面板 DMA 与显示。
# The host allocates from PSRAM, leaving internal RAM to the panel DMA and the display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 只做 central；用不到的角色连缓冲一起编掉。
# Central only; the unused roles and their buffers are compiled out.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# bond 密钥必须落 NVS，否则每次重启都要重新配对，自动重连形同虚设。这项默认是 n。
# Bond keys must reach NVS, or every reboot re-pairs and auto-reconnect is useless. Defaults to n.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# 输入报告最多 4 个（MAX_INPUT_CHRS），CCCD 数要跟得上，否则只有前两条订阅能跨重启保留。
# Up to four input reports (MAX_INPUT_CHRS); the CCCD budget must match or only the first two
# subscriptions survive a reboot.
CONFIG_BT_NIMBLE_MAX_CCCDS=4
# 连接后交换到 185：Report Map 的分段读一次走 MTU-1 字节，23 时要几十个往返，185 时只剩几个，
# 解锁后重连的等待随之缩短。对端拒绝时协议栈仍按 23 工作。
# Exchange up to 185 after connecting: the chunked Report Map read moves MTU-1 bytes per round
# trip, dozens at 23 and only a few at 185, which shortens the wait after unlocking. A peer that
# refuses leaves the link at 23.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
# BLE 5 扩展扫描：只发扩展广播的设备（新遥控器）也要扫得到。打开后所有发现报告改走
# BLE_GAP_EVENT_EXT_DISC，Legacy 广播同样从这条路来；本机不广播，所以广播数据与周期同步
# 全部关掉，只留扫描。
# BLE 5 extended scanning: devices that only advertise in extended form (newer remotes) must be
# visible too. With it on, every discovery report arrives as BLE_GAP_EVENT_EXT_DISC, legacy
# advertisements included. This board never advertises, so advertising data and periodic sync are
# switched off and only scanning remains.
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=31
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=n
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=n
# 控制器只能用内部 RAM——它跑在硬件路径上，读不到 PSRAM；内部 RAM 就是启动门槛卡的那一项。
# S31 的控制器换成 BTDM 之后，S3 上的 BLE_MAX_ACT / ADV_DUP_FILT_MAX 已不存在，这里只留
# 仍然有效的报告流控深度；扫描去重深度用控制器默认值。
# The controller must stay in internal RAM (it sits on the hardware path and cannot read PSRAM),
# and internal RAM is what the start gate checks. With the S31's BTDM controller, the S3 settings
# BLE_MAX_ACT / ADV_DUP_FILT_MAX no longer exist; only the report flow-control depth remains,
# and the scan dedup depth keeps the controller default.
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BLE_MESH=n

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico SD"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MindReset"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 建立链路的回调链跑在 NimBLE 任务上，通知解析里 4096 字节会触到栈上限。
# The bring-up callback chain runs on the NimBLE task; 4096 bytes reaches its limit inside report parsing.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# S31 的 RTC 时钟源只有内部 RC 与外部晶振；先沿用内部 RC，标定周期按 Metalio。
# S31 offers only internal RC or an external crystal for RTC; keep internal RC for now.
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_RTC_CLK_CAL_CYCLES=1024
CONFIG_LIBC_TIME_SYSCALL_USE_RTC_HRT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
