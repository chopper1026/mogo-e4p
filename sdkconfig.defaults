# 目标：ESP32-S31（RISC-V，Metalio E-INK4 Plus）。
# Target: ESP32-S31 (RISC-V, Metalio E-INK4 Plus).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# S31 + Octal PSRAM 200 MHz（Metalio 已验证组合）。flash 保持 80 MHz 默认。
# S31 + octal PSRAM at 200 MHz (validated on Metalio); flash stays at the 80 MHz default.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# 多层 EPUB/PNG 调用留安全余量；大型缓存不得放栈上。/ Reserve nested EPUB/PNG stack headroom; keep large caches off-stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# 首版与 Metalio 一致：UART0 主控制台 + USB Serial/JTAG 次控制台，便于看启动日志。
# Match Metalio for bring-up: UART0 primary console with USB Serial/JTAG secondary.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 只服务一个浏览器，但发送/接收批量书本时仍需要足够的帧缓冲形成聚合。
# 4/8/4 的旧值把实测吞吐压到约 40–90 KB/s；这里取默认档位的一半，兼顾内部堆。
# One browser client at a time, but bulk book transfers still need enough frame
# buffers to aggregate. The old 4/8/4 values measured at only 40–90 KB/s; these
# sit at half the IDF defaults to keep internal heap in reserve.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# TCP 窗口是传书吞吐的直接上限：5760 字节在 60 ms 量级的往返里只有约 90 KB/s。
# The TCP window is the direct throughput ceiling: 5760 bytes over a ~60 ms
# turnaround caps transfers near 90 KB/s. 32 KB keeps the backlog in PSRAM.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙翻页器：BLE HID 主机（central），配对市面上的 BLE 翻页器／键盘。
# Bluetooth page-turner: a BLE HID host (central) pairing off-the-shelf BLE remotes.
#
# 只用 BLE。ESP32-S3 没有 Bluetooth Classic 射频，纯 Classic 的翻页器连不上。
# BLE only. The ESP32-S3 has no Bluetooth Classic radio, so Classic-only remotes cannot pair.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# host 的全部动态分配走 PSRAM，内部 RAM 留给面板 DMA 与显示。
# The host allocates from PSRAM, leaving internal RAM to the panel DMA and the display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 只做 central；用不到的角色连缓冲一起编掉。
# Central only; the unused roles and their buffers are compiled out.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# bond 密钥必须落 NVS，否则每次重启都要重新配对，自动重连形同虚设。这项默认是 n。
# Bond keys must reach NVS, or every reboot re-pairs and auto-reconnect is useless. Defaults to n.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
# 控制器只能用内部 RAM——它跑在硬件路径上，读不到 PSRAM。这组值是 CrossMux 在同一块
# 板子上验证过的：BLE_MAX_ACT 是"同时允许几个控制器活动"，扫描与建立连接各占一个，
# 压到 1 会让扫描和连接互相排斥，起不来。文件/图片/壁纸列表等搬进 PSRAM 之后 DIRAM
# 空闲约 148KB，这里不需要再省。
# The controller must stay in internal RAM (it sits on the hardware path and cannot read PSRAM).
# These are the values CrossMux verified on this same board: BLE_MAX_ACT is how many controller
# activities may coexist, scanning and connection setup each take one, and squeezing it to 1 makes
# them mutually exclusive so the stack cannot come up. After the file, image and wallpaper lists
# moved into PSRAM, DIRAM has about 148 KB free, so there is nothing left to economise here.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10
CONFIG_BLE_MESH=n

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico SD"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MindReset"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 建立链路的回调链跑在 NimBLE 任务上，通知解析里 4096 字节会触到栈上限。
# The bring-up callback chain runs on the NimBLE task; 4096 bytes reaches its limit inside report parsing.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=8192

# S31 的 RTC 时钟源只有内部 RC 与外部晶振；先沿用内部 RC，标定周期按 Metalio。
# S31 offers only internal RC or an external crystal for RTC; keep internal RC for now.
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_RTC_CLK_CAL_CYCLES=1024
CONFIG_LIBC_TIME_SYSCALL_USE_RTC_HRT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
